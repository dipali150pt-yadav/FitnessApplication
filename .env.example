# Google Gemini API Key (Required for AI workout recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# Keycloak Configuration (Optional - for authentication)
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_REALM=fitness-realm
KEYCLOAK_URL=http://localhost:8180

# Database Passwords (Already set in docker-compose, change for production)
POSTGRES_PASSWORD=pass123
MYSQL_ROOT_PASSWORD=pass123

# RabbitMQ Configuration (Already set in docker-compose)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
